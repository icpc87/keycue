<Project Sdk="Microsoft.NET.Sdk">
  <!-- KeyCue の Windows 版（WPF）。Mac でもビルドできる（EnableWindowsTargeting）。動かすのは Windows -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>KeyCue</AssemblyName>
    <RootNamespace>KeyCue.Windows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/KeyCue.ico</ApplicationIcon>
    <Product>KeyCue</Product>
    <Company>ic2</Company>
    <Copyright>© 2026 Hiroki Ichiyanagi</Copyright>
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../../VERSION').Trim())</Version>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <!-- FFmpeg の Windows 用ライブラリ（BtbN/FFmpeg-Builds の LGPL 版）を置いた場所 -->
    <FFmpegRoot Condition="'$(FFmpegRoot)' == ''">$(HOME)/Library/Developer/KeyCue/windows-deps</FFmpegRoot>
    <FFmpegArch Condition="'$(RuntimeIdentifier)' == 'win-arm64'">winarm64</FFmpegArch>
    <FFmpegArch Condition="'$(FFmpegArch)' == ''">win64</FFmpegArch>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyMetadata Include="BuildNumber" Value="$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../../BUILD_NUMBER').Trim())" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../KeyCue.Core/KeyCue.Core.csproj" />
    <ProjectReference Include="../KeyCue.Media/KeyCue.Media.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets/KeyCue.ico" />
    <Resource Include="Assets/icon_256.png" />
    <!-- GPL 版（x264・x265・SRT 入り）。ffmpeg.exe は録画・配信に使う -->
    <None Include="$(FFmpegRoot)/x-$(FFmpegArch)-gpl/*/bin/*.dll" Link="ffmpeg/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(FFmpegRoot)/x-$(FFmpegArch)-gpl/*/bin/ffmpeg.exe" Link="ffmpeg/ffmpeg.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(FFmpegRoot)/x-$(FFmpegArch)-gpl/*/LICENSE.txt" Link="ffmpeg/LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
